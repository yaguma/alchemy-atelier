{
  "mcpServers": {
    "godot-ai": {
      "type": "stdio",
      "command": "godot-ai",
      "args": [
        "attach",
        "--port",
        "8000",
        "--ws-port",
        "9500",
        "--disable-telemetry"
      ],
      "env": {
        "GODOT_AI_DISABLE_TELEMETRY": "true"
      }
    }
  }
}
